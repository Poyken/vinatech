// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  description   String
  price         Float
  originalPrice Float?
  images        String[]    // Array of image paths/URLs
  brand         String
  type          String      // e.g., Bookshelf, Bluetooth, Floorstanding, Soundbar, Headphones
  specs         Json        // Technical specifications as JSON
  stock         Int         @default(0)
  rating        Float       @default(0.0)
  audioUrl      String?     // Optional URL to a speaker demo audio track
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reviews       Review[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  userName  String
  rating    Int
  comment   String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Order {
  id            String      @id @default(uuid())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  paymentMethod String      // COD, BankTransfer
  status        String      // PENDING, PROCESSING, COMPLETED, CANCELLED
  total         Float
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
