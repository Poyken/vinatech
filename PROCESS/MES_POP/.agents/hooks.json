{
  "enterprise-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File ..\\..\\tools\\shared\\safety_hook.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enterprise-governance-reminder": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell -ExecutionPolicy Bypass -File ..\\..\\tools\\shared\\reminder_hook.ps1",
        "timeout": 5
      }
    ]
  }
}